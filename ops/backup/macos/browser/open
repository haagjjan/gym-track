#!/bin/bash

set -euo pipefail
umask 077

# cloudflared invokes `open` through PATH on macOS. Fail closed for other URLs.
[[ "$#" -eq 1 ]] || exit 1
case "$1" in
  https://ssh.gymtrack.ch/cdn-cgi/access/cli\?*) ;;
  *) exit 1 ;;
esac

readonly STATE_DIR="${HOME}/Library/Application Support/GymTrackerBackup/state"
readonly STAMP="${STATE_DIR}/last-browser-prompt"
mkdir -p "${STATE_DIR}"
# The shell holds descriptor 9; the OS releases its lock even if the opener crashes.
exec 9> "${STATE_DIR}/browser.lock"
/usr/bin/lockf -s -t 0 9 || exit 0

now="$(date +%s)"
last=0
if [[ -f "${STAMP}" ]]; then
  read -r last < "${STAMP}" || true
  # A damaged timestamp must not restart an unlimited prompting loop.
  case "${last}" in
    ''|*[!0-9]*) exit 1 ;;
  esac
fi
if (( now - 10#${last} < 86400 )); then
  exit 0
fi

# Reserve the prompt before opening so a crash cannot cause duplicate tabs.
printf '%s\n' "${now}" > "${STAMP}.tmp"
mv -f "${STAMP}.tmp" "${STAMP}"
/usr/bin/open "$1"
