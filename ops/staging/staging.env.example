# Copy to /srv/gym-tracker-staging/deploy/env/staging.env and replace every
# REQUIRED value. This file contains no secrets; keep live values off Git.
APP_RELEASE=REQUIRED_FULL_40_CHARACTER_GIT_SHA
STAGING_POSTGRES_IMAGE=gym-tracker-staging-postgres:REQUIRED_SHA
STAGING_MIGRATE_IMAGE=gym-tracker-staging-migrate:REQUIRED_SHA
STAGING_API_IMAGE=gym-tracker-staging-api:REQUIRED_SHA
STAGING_WEB_IMAGE=gym-tracker-staging-web:REQUIRED_SHA

STAGING_PROXY_PORT=3100
STAGING_CADDYFILE=/srv/gym-tracker-staging/deploy/config/caddy/Caddyfile

POSTGRES_OWNER_PASSWORD_FILE=/srv/gym-tracker-staging/secrets/postgres-owner-password
POSTGRES_APP_PASSWORD_FILE=/srv/gym-tracker-staging/secrets/postgres-app-password
BFF_CLIENT_IP_SECRET_FILE=/srv/gym-tracker-staging/secrets/bff-client-ip-secret
RESEND_API_KEY_FILE=/srv/gym-tracker-staging/secrets/resend-api-key
EMAIL_RECIPIENT_ALLOWLIST_FILE=/srv/gym-tracker-staging/secrets/email-recipient-allowlist

EMAIL_FROM="Gym Progress Tracker Staging <staging@send.gymtrack.ch>"
SUPPORT_EMAIL=REQUIRED_SUPPORT_EMAIL
CONTROLLER_NAME="REQUIRED_CONTROLLER_NAME"
CONTROLLER_ADDRESS="REQUIRED_CONTROLLER_ADDRESS"
PRIVACY_EMAIL=REQUIRED_PRIVACY_EMAIL
SECURITY_EMAIL=REQUIRED_SECURITY_EMAIL
SUPPORT_URL=""

REGISTRATION_MODE=INVITE_ONLY
AUTH_SESSION_TTL_DAYS=30
LOG_LEVEL=info
