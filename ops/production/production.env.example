# Copy to /srv/gym-tracker/deploy/env/production.env only after the release is committed
# and its exact SHA has a green CI run. Keep the deployed file outside Git.
APP_RELEASE=REQUIRED_FULL_GIT_SHA
PRODUCTION_MIGRATE_IMAGE=gym-tracker-migrate:REQUIRED_FULL_GIT_SHA
PRODUCTION_API_IMAGE=gym-tracker-api:REQUIRED_FULL_GIT_SHA
PRODUCTION_WEB_IMAGE=gym-tracker-web:REQUIRED_FULL_GIT_SHA

# The current Cloudflare Tunnel reaches the reviewed LAN-only Caddy listener.
PRODUCTION_PROXY_BIND=192.168.1.57
PRODUCTION_PROXY_PORT=80

# Keep disabled through migration and initial health checks. Change both API and web together
# to INVITE_ONLY only after the production black-box checks pass.
REGISTRATION_MODE=DISABLED

AUTH_SESSION_TTL_DAYS=30
LOG_LEVEL=info
EMAIL_FROM="Gym Progress Tracker <noreply@send.gymtrack.ch>"
CONTROLLER_NAME="Jan Haag"
CONTROLLER_ADDRESS="Lerchenstrasse 74, 4059 Basel, Switzerland"
PRIVACY_EMAIL=privacy@gymtrack.ch
SUPPORT_EMAIL=support@gymtrack.ch
SECURITY_EMAIL=security@gymtrack.ch
SUPPORT_URL=
