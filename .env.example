POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gym_progress_tracker
POSTGRES_USER=gym_progress_tracker
POSTGRES_PASSWORD=gym_progress_tracker_password
DATABASE_URL=postgresql://gym_progress_tracker:gym_progress_tracker_password@localhost:5432/gym_progress_tracker

API_PORT=4000
API_HOST=0.0.0.0
API_TRUST_PROXY=false
APP_ENV=local
# Set this to the deployed Git SHA/tag in production.
APP_RELEASE=development
METRICS_ENABLED=false
LOG_LEVEL=info
AUTH_COOKIE_NAME=gym_progress_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
APP_BASE_URL=http://localhost:3000
EMAIL_FROM=Gym Progress Tracker <onboarding@resend.dev>
# Leave unset locally: auth emails (verification/reset links) print to the API log instead.
RESEND_API_KEY=
WEB_PORT=3000
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CLIENT_DIAGNOSTICS=0

# Stage 1 private monitoring overlay (`pnpm ops:monitoring:start`).
PROMETHEUS_RETENTION_TIME=30d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=operator
# These ignored files must contain only the corresponding password, with mode 600.
GRAFANA_ADMIN_PASSWORD_FILE=./ops/monitoring/secrets/grafana_admin_password
POSTGRES_MONITOR_PASSWORD_FILE=./ops/monitoring/secrets/postgres_monitor_password
