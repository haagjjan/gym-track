POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gym_progress_tracker
POSTGRES_USER=gym_progress_tracker
POSTGRES_PASSWORD=gym_progress_tracker_password
DATABASE_URL=postgresql://gym_progress_tracker:gym_progress_tracker_password@localhost:5432/gym_progress_tracker

API_PORT=4000
API_HOST=0.0.0.0
# Fastify receives only internal Next.js BFF traffic, not edge requests.
API_TRUST_PROXY=false
APP_ENV=local
# The existing HTTP-only home-server deployment uses `private-lan`. Public
# production must use a different label and satisfy the HTTPS/contact checks.
# Set this to the deployed Git SHA/tag in production.
APP_RELEASE=development
METRICS_ENABLED=false
LOG_LEVEL=info
AUTH_COOKIE_NAME=gym_progress_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
# Local development remains open. Production defaults closed when this is omitted.
REGISTRATION_MODE=ENABLED
# 32+ random characters shared only by the Next.js BFF and API. It signs the
# trusted edge client IP used for public rate limiting.
BFF_CLIENT_IP_SECRET=
APP_BASE_URL=http://localhost:3000
# Comma-separated hostnames/origins accepted by the Next.js ingress guard.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.57
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.57
# Comma-separated hostnames permanently redirected (308) to APP_BASE_URL, path
# and query preserved. When unset, the bare registrable domain of APP_BASE_URL
# and its `www.` variant are used — for `https://app.gymtrack.ch` that is
# `gymtrack.ch` and `www.gymtrack.ch`. Set it explicitly for a multi-part
# suffix such as `.co.uk`, or to an empty value to disable the redirect. DNS
# for these hostnames must reach the same ingress. Leave this line commented
# out to keep the derived default; an empty value disables the redirect.
# APP_REDIRECT_HOSTS=
# Enable only after the canonical HTTPS hostname is stable and verified.
HSTS_ENABLED=false
EMAIL_FROM=Gym Progress Tracker <onboarding@resend.dev>
# Required for APP_ENV=staging. Comma-separated owner-controlled recipients only.
EMAIL_RECIPIENT_ALLOWLIST=
# Leave unset locally: auth emails (verification/reset links) print to the API log instead.
RESEND_API_KEY=
SUPPORT_EMAIL=
TELEGRAM_BETA_BOT_TOKEN=
TELEGRAM_BETA_CHAT_ID=
WEB_PORT=3000
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CLIENT_DIAGNOSTICS=0

# Published controller identity and contacts, rendered on /privacy, /terms,
# /cookies and /support. These are deliberately NOT `NEXT_PUBLIC_*`: Next.js
# inlines that prefix at build time and never re-reads it, so prefixed values
# would be baked in during `docker build` and could not be configured at
# runtime. Plain server variables are read per request.
#
# Leaving any of the first four empty makes the legal pages render a visible
# PUBLICATION_BLOCKED warning. That guard is intentional — do not remove it,
# and do not publish placeholder facts.
CONTROLLER_NAME=
CONTROLLER_ADDRESS=
PRIVACY_EMAIL=
SECURITY_EMAIL=
# Optional voluntary-support link. Leave empty unless provider terms and
# voluntary/no-benefit wording have been approved.
SUPPORT_URL=

# Stage 1 private monitoring overlay (`pnpm ops:monitoring:start`).
PROMETHEUS_RETENTION_TIME=30d
NODE_EXPORTER_TEXTFILE_DIR=./ops/monitoring/textfile
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=operator
# These ignored files must contain only the corresponding password, with mode 600.
GRAFANA_ADMIN_PASSWORD_FILE=./ops/monitoring/secrets/grafana_admin_password
POSTGRES_MONITOR_PASSWORD_FILE=./ops/monitoring/secrets/postgres_monitor_password
ALERTMANAGER_TELEGRAM_BOT_TOKEN_FILE=./ops/monitoring/secrets/alertmanager_telegram_bot_token
ALERTMANAGER_TELEGRAM_CHAT_ID_FILE=./ops/monitoring/secrets/alertmanager_telegram_chat_id
