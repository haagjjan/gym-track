# Copy to keystore.properties (never committed) and fill in. The keystore file path is
# relative to apps/mobile/android. Create the upload key once:
#   keytool -genkeypair -v -keystore gymtrack-upload.jks -alias gymtrack -keyalg RSA -keysize 2048 -validity 10000
storeFile=gymtrack-upload.jks
storePassword=
keyAlias=gymtrack
keyPassword=
