{
  "name": "@gym-progress-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:promote": "node scripts/promote-admin.mjs",
    "build": "tsc --project tsconfig.build.json --pretty false",
    "catalog:build": "node scripts/build-system-exercise-catalog.mjs",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --no-error-on-unmatched-pattern --max-warnings=0",
    "migrate": "node-pg-migrate --config-file db/migrate.json --envPath ../../.env",
    "migrate:create": "pnpm migrate create --migration-file-language sql",
    "migrate:down": "pnpm migrate down",
    "migrate:redo": "pnpm migrate redo",
    "migrate:up": "pnpm migrate up",
    "start": "node dist/main.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:performance": "node --import tsx --test --test-concurrency=1 \"src/**/*.performance-test.ts\"",
    "test:integration": "node --import tsx --test \"src/**/*.integration-test.ts\"",
    "type-check": "tsc --noEmit --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "kysely": "^0.27.6",
    "papaparse": "^5.5.3",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.11",
    "node-pg-migrate": "^8.0.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.3"
  }
}
