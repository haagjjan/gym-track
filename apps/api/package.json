{
  "name": "@gym-progress-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.json --pretty false",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --no-error-on-unmatched-pattern --max-warnings=0",
    "migrate": "node-pg-migrate --config-file db/migrate.json --envPath ../../.env",
    "migrate:create": "pnpm migrate create --migration-file-language sql",
    "migrate:down": "pnpm migrate down",
    "migrate:redo": "pnpm migrate redo",
    "migrate:up": "pnpm migrate up",
    "type-check": "tsc --noEmit --project tsconfig.json --pretty false"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "kysely": "^0.27.6",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.19.3"
  }
}
