{
  "name": "gym-progress-tracker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm type-check && pnpm lint && pnpm build",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.1"
  }
}
